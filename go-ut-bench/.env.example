# ut-bench 环境变量配置
# 复制本文件为 .env 并填入你的 API Key：
#   cp .env.example .env
#
# 只需填写你实际使用的模型对应的 Key。
# 未配置 Key 的模型在 Web UI 中会标红，运行时会报错跳过。

# ── DeepSeek ──────────────────────────────────────────────
# 用于: deepseek-v4-flash, deepseek-v4-pro
# 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── MiniMax ───────────────────────────────────────────────
# 用于: minimax2.7, minimax2.5
# 获取: https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=
# MINIMAX2.5_API_KEY=   # 如需独立 Key 可取消注释

# ── 火山引擎 / 豆包 ──────────────────────────────────────
# 用于: doubao-seed (原始接入点)
# 获取: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
VOLCENGINE_API_KEY=

# 用于: doubao-seed-2.0-lite/1.6/2.0-pro-v2, glm-4.7, deepseek-v3.2 (通过 ARK 接入)
# 获取: 同上
ARK_API_KEY=

# ── 阿里云 DashScope ─────────────────────────────────────
# 用于: glm-5, qwen3.6-flash
# 获取: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# ── CodeBuddy (可选) ─────────────────────────────────────
# 用于: CodeBuddy Agent 框架测试
# 获取: https://codebuddy.qq.com/
CODEBUDDY_API_KEY=
CODEBUDDY_INTERNET_ENVIRONMENT=internal

# ── Claude Code (可选) ────────────────────────────────────
# 用于: Claude Code Agent 框架自定义模型端点认证
# 设为对应 provider 的 API Key 即可
# ANTHROPIC_AUTH_TOKEN=

# ── 测试占位 ──────────────────────────────────────────────
# dry-run 模式下用于占位，无需真实 Key
TEST_API_KEY=test_key_for_dry_run
