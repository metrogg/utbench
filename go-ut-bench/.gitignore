# Build artifacts
utbench

# Go build cache
.gocache/

# Go module cache
.gomodcache/

# Java/Maven local cache
.m2-cache/

# Runtime artifacts
artifacts/*
!artifacts/.gitkeep
storage/*
!storage/.gitkeep

# Dataset indexes (generated)
configs/dataset_index.json

# Python workspace artifacts (mutation testing, coverage, etc.)
**/workspace/mutants/
**/workspace/.mutmut-cache
**/workspace/.mutmut_shim/
**/workspace/.pytest_cache/
**/workspace/.coverage*
**/workspace/pyproject.toml
**/workspace/__pycache__/
**/workspace/tests/__pycache__/
**/workspace/**/__pycache__/

# Test files generated by models (keep manually created tests)
**/workspace/tests/test_*_test.py

# Keep original test fixtures
!**/workspace/tests/.gitkeep

# Go evaluation artifacts
**/cover.out
**/*.test
artifacts/go_manual_test/
artifacts/go_test_manifest.json

# IDE and editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build/Docker logs
*.log
docker_build*

# Pre-built binaries
*.tar
*.exe

# Environment files
.env
*.exe~
