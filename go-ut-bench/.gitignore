# 本地密钥和环境配置
.env
.env.*
!.env.example

# 本地 Agent/IDE 状态
.claude/
.codebuddy/
.opencode/
.windsurf/
.workbuddy/
.trae/
.codesandbox/
.idea/
.vscode/

# Go 构建、测试和缓存产物
/utbench
/utbench.exe
/utbench-*
*.exe
*.exe~
*.test
*.out
.gocache/
.gomodcache/
coverage.out
cover.out
**/cover.out

# 打包和通用构建目录
dist/
build/
*.tar
*.zip
*.gz

# 运行产物和本地数据库
artifacts/*
!artifacts/.gitkeep
storage/*
!storage/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 自动生成的索引、清单和结果
configs/dataset_index.json
artifacts/go_manual_test/
artifacts/go_test_manifest.json
generated_manifest.json
evaluation_result.json

# Agent、评测器和沙箱工作区产物
**/agent_workspaces/
**/workspace/mutants/
**/workspace/.mutmut-cache/
**/workspace/.mutmut_shim/
**/workspace/.pytest_cache/
**/workspace/.coverage*
**/workspace/pyproject.toml
**/workspace/__pycache__/
**/workspace/tests/__pycache__/
**/workspace/**/__pycache__/
**/workspace/tests/test_*_test.py
!**/workspace/tests/.gitkeep

# 各语言/工具缓存
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
node_modules/
.npm/
.yarn/
.pnpm-store/
target/
.gradle/
.m2-cache/
*.class

# 日志和临时文件
*.log
docker_build*
*.tmp
*.temp
*.bak
*.swp
*.swo

# 系统元数据
.DS_Store
Thumbs.db
desktop.ini
