# .env.example - Environment variables for API keys
# Copy to .env and fill in your actual keys

# --- 模型 Provider API Keys ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here
VOLCENGINE_API_KEY=your_doubao_api_key_here
DASHSCOPE_API_KEY=your_qwen_api_key_here
BIGMODEL_API_KEY=your_glm_api_key_here
ARK_API_KEY=your_ark_api_key_here

# --- Claude Code 自定义模型端点 ---
# 使用 Claude Code 接入非 Claude 模型（如 DeepSeek、MiniMax）时：
# ANTHROPIC_BASE_URL 会由 UT-Bench 从 models.yaml 的 endpoint 自动注入，无需手动设置。
# 只需将 ANTHROPIC_AUTH_TOKEN 设置为对应 provider 的 API key 即可。
# 例如使用 DeepSeek: export ANTHROPIC_AUTH_TOKEN=$DEEPSEEK_API_KEY
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here

# --- 测试用 ---
TEST_API_KEY=test_key_for_dry_run
